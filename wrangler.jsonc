{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "institutokhuririm",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "institutokhuririm.com.br", "custom_domain": true },
    { "pattern": "www.institutokhuririm.com.br", "custom_domain": true }
  ],
  "main": "src/worker.js",
  "assets": {
    "directory": "./instituto-khuririm-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
